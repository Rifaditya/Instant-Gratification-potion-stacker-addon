{
    "schemaVersion": 1,
    "id": "potion-stacker-addon",
    "version": "${version}",
    "name": "Potion Stacker Addon",
    "description": "An addon for Stack Size Adjuster that allows customizing stack limits for potions dynamically using GameRules or configuration screens.",
    "authors": [
        "Dasik (Rifaditya)"
    ],
    "contact": {
        "homepage": "https://github.com/Rifaditya/Instant-Gratification-potion-stacker-addon",
        "sources": "https://github.com/Rifaditya/Instant-Gratification-potion-stacker-addon"
    },
    "license": "GPL-3.0-or-later",
    "icon": "assets/potion-stacker-addon/icon.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "net.instantgratification.potionstacker.PotionStackerFabric"
        ],
        "client": [
            "net.instantgratification.potionstacker.PotionStackerFabricClient"
        ],
        "modmenu": [
            "net.instantgratification.potionstacker.config.ModMenuIntegration"
        ]
    },
    "depends": {
        "fabricloader": ">=0.19.1",
        "minecraft": "${minecraft_dependency}",
        "java": ">=25",
        "fabric-api": "*",
        "dasik-library": ">=1.8.3",
        "stack-size-adjuster": ">=1.4.10+26.2"
    },
    "suggests": {
        "cloth-config": "*",
        "modmenu": "*"
    },
    "custom": {
        "modmenu": {
            "links": {
                "modmenu.donate": "https://ko-fi.com/dasikigaijin",
                "modmenu.kofi": "https://ko-fi.com/dasikigaijin"
            }
        }
    }
}
